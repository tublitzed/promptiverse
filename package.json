{
  "name": "promptiverse",
  "version": "0.0.1",
  "private": true,
  "dependencies": {
    "@auth0/auth0-react": "^1.10.2",
    "axios": "^0.27.2",
    "dotenv": "^10.0.0",
    "dotenv-expand": "^5.1.0",
    "react": "^17.0.2",
    "react-app-polyfill": "^3.0.0",
    "react-dev-utils": "^12.0.1",
    "react-dom": "^17.0.2",
    "react-refresh": "^0.11.0",
    "react-router-dom": "^5.3.3",
    "webpack": "5.72.0",
    "webpack-cli": "4.9.2"
  },
  "scripts": {
    "start": "node ./bin/www",
    "build:css": "npx tailwindcss --postcss -i ./src/css/base.css -o ./public/css/base.bundle.css",
    "build:dev": "NODE_ENV=development webpack --config ./config/webpack/webpack.config.js",
    "build": "NODE_ENV=production webpack --config ./config/webpack/webpack.config.js && npm run build:css",
    "dev": "concurrently --restart-tries=5 --restart-after=100 --prefix={pid} --prefix-colors=blue,yellow,green,magenta 'npm run build:css -- --watch' 'npm run build:dev'",
    "format": "prettier . --write",
    "lint:fix": "npm run lint:ts -- --fix && npm run lint:styles -- --fix",
    "lint:styles": "npx stylelint src/**/*.css",
    "lint:ts": "tslint ./src/**/*{.tsx,.ts}",
    "lint": "npm run lint:ts && npm run lint:styles",
    "test": "jest  --config=./src/tests/jest.config.ts"
  },
  "devDependencies": {
    "@babel/core": "7.18.10",
    "@babel/preset-env": "7.18.10",
    "@babel/preset-react": "7.18.6",
    "@babel/preset-typescript": "7.18.6",
    "@types/classnames": "2.3.0",
    "@types/jest": "27.5.2",
    "@types/node": "16.11.47",
    "@types/react": "18.0.15",
    "@types/react-dom": "18.0.6",
    "@types/react-router-dom": "^5.3.3",
    "autoprefixer": "^10.4.12",
    "concurrently": "7.3.0",
    "eslint": "7.32.0",
    "husky": "^8.0.1",
    "jest": "27.5.1",
    "lint-staged": "12.5.0",
    "postcss-import": "^14.1.0",
    "source-map-loader": "1.1.3",
    "stylelint": "14.9.1",
    "stylelint-config-standard": "^25.0.0",
    "tailwindcss": "^3.0.24",
    "ts-debounce": "2.3.0",
    "ts-loader": "9.3.1",
    "ts-node": "10.7.0",
    "typescript": "4.7.4"
  }
}

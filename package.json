{
  "name": "promptiverse",
  "version": "0.0.1",
  "description": "## Setup",
  "main": "index.js",
  "scripts": {
    "test": "echo \"Error: no test specified\" && exit 1",
    "build:css": "npx tailwindcss --postcss -i ./src/css/base.css -o ./static/css/base.bundle.css",
    "build:dev": "NODE_ENV=development webpack --config ./config/webpack/webpack.config.js",
    "build": "NODE_ENV=production webpack --config ./config/webpack/webpack.config.js && npm run build:css",
    "dev": "concurrently --restart-tries=5 --restart-after=100 --prefix={pid} --prefix-colors=blue,yellow,green,magenta 'npm run build:css -- --watch' 'npm run build:dev'"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/tublitzed/promptiverse.git"
  },
  "author": "tublitzed@gmail.com",
  "license": "ISC",
  "bugs": {
    "url": "https://github.com/tublitzed/promptiverse/issues"
  },
  "homepage": "https://github.com/tublitzed/promptiverse#readme",
  "dependencies": {
    "tailwindcss": "^3.1.8"
  },
  "devDependencies": {
    "@types/node": "^18.7.23",
    "autoprefixer": "^10.4.12",
    "concurrently": "^7.4.0",
    "ts-loader": "^9.4.1",
    "typescript": "^4.8.4",
    "webpack": "^5.74.0",
    "webpack-cli": "^4.10.0"
  }
}

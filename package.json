{
  "name": "promptiverse",
  "version": "0.0.3",
  "private": true,
  "dependencies": {
    "@auth0/auth0-react": "^1.10.2",
    "@headlessui/react": "^1.7.3",
    "@heroicons/react": "^2.0.12",
    "@sentry/react": "^7.18.0",
    "@sentry/tracing": "^7.18.0",
    "axios": "^0.31.1",
    "clsx": "^1.2.1",
    "date-fns": "^2.29.3",
    "dotenv": "^10.0.0",
    "dotenv-expand": "^5.1.0",
    "logrocket": "^3.0.1",
    "react": "^17.0.2",
    "react-app-polyfill": "^3.0.0",
    "react-dev-utils": "^12.0.1",
    "react-dom": "^17.0.2",
    "react-refresh": "^0.11.0",
    "react-router-dom": "^5.3.3",
    "react-select": "^5.5.0",
    "uuid": "^9.0.0",
    "webpack": "5.88.2",
    "webpack-cli": "4.9.2"
  },
  "scripts": {
    "build:css": "npx tailwindcss --postcss -i ./src/css/base.css -o ./static/css/base.bundle.css",
    "build:dev": "NODE_ENV=development webpack --config ./config/webpack/webpack.config.js",
    "build": "NODE_ENV=production webpack --config ./config/webpack/webpack.config.js && npm run build:css",
    "dev": "concurrently --restart-tries=5 --restart-after=100 --prefix={pid} --prefix-colors=blue,yellow,green,magenta 'npm run build:css -- --watch' 'npm run build:dev'",
    "format": "npx eslint './**' --fix",
    "prepare": "husky install"
  },
  "devDependencies": {
    "@babel/core": "7.22.9",
    "@babel/preset-env": "7.18.10",
    "@babel/preset-react": "7.18.6",
    "@babel/preset-typescript": "7.18.6",
    "@types/classnames": "2.3.0",
    "@types/jest": "29.5.3",
    "@types/node": "16.11.47",
    "@types/react": "18.0.15",
    "@types/react-dom": "18.0.6",
    "@types/react-router-dom": "^5.3.3",
    "@types/uuid": "^8.3.4",
    "@typescript-eslint/eslint-plugin": "^5.39.0",
    "autoprefixer": "^10.4.12",
    "concurrently": "7.3.0",
    "eslint": "^8.25.0",
    "eslint-config-standard-with-typescript": "^23.0.0",
    "eslint-plugin-import": "^2.26.0",
    "eslint-plugin-n": "^15.7.0",
    "eslint-plugin-promise": "^6.0.1",
    "eslint-plugin-react": "^7.31.8",
    "husky": "^8.0.0",
    "lint-staged": "13.2.3",
    "postcss-import": "^14.1.0",
    "source-map-loader": "1.1.3",
    "stylelint": "14.9.1",
    "stylelint-config-standard": "^26.0.0",
    "tailwindcss": "^3.3.3",
    "ts-debounce": "2.3.0",
    "ts-loader": "9.3.1",
    "ts-node": "10.7.0",
    "typescript": "^4.8.4"
  },
  "lint-staged": {
    "*.{js,jsx,ts,tsx}": "eslint --fix"
  },
  "engines": {
    "node": "20.x"
  }
}
